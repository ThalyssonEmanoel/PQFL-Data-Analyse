# ============================================================
# PQFL - Front-end — exemplo de variaveis de ambiente
# Copie para .env e ajuste conforme o ambiente.
# Variaveis expostas ao browser DEVEM comecar com VITE_.
# ============================================================

# Base da API consumida pelo front-end.
#  - Em desenvolvimento, deixe "/api" para usar o proxy do Vite (vite.config.js),
#    o que evita CORS e mantem o cookie httpOnly de refresh no mesmo site.
#  - Em producao (Render), aponte para a URL publica do back-end, ex.:
#    VITE_API_BASE_URL=https://pqfl-api.onrender.com
VITE_API_BASE_URL=/api

# Alvo do proxy de desenvolvimento (usado apenas pelo Vite em "npm run dev").
VITE_DEV_API_PROXY=http://localhost:8080
