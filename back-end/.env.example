# ============================================================
# PQFL - Back-end — exemplo de variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# ============================================================

NODE_ENV=development            # development | staging | production
PORT=8080

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://yfdfhhdhw
MONGODB_URI_TEST=mongodb://localhost:27017/pqfl_test
MONGO_MAX_POOL_SIZE=           
MONGO_READ_PREFERENCE=          

# ---- Coletum ----
COLETUM_BASE_URL=
COLETUM_FORM_ID=
COLETUM_TOKEN=
COLETUM_MAX_REQUESTS_PER_RUN=

# ---- JWT (RS256) ----
# Gerar as chaves com: node scripts/generate-keys.js
# Em producao prefira injetar o conteudo via JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (PEM) ou via secret manager.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
# JWT_PRIVATE_KEY=                 # alternativa: PEM inline (tem prioridade sobre o PATH)
# JWT_PUBLIC_KEY=
JWT_ISSUER=pqfl-api
JWT_AUDIENCE=pqfl-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_WEB=7d
REFRESH_TOKEN_TTL_MOBILE=30d

# ---- Seed (npm run seed) — cria 1 admin + 3 members, nada mais ----
SEED_ADMIN_EMAIL=admin@pqfl.example.com
SEED_ADMIN_PASSWORD=changeme-strong
SEED_MEMBER_PASSWORD=changeme-strong
SEED_MEMBER_EMAILS=member1@pqfl.local,member2@pqfl.local,member3@pqfl.local

# ---- E-mail ----
MAIL_PROVIDER=console            # console | smtp  (console = imprime no log, util em dev)
MAIL_FROM="PQFL <no-reply@pqfl.example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Front-end / CORS ----
FRONT_URL=https://dashboard.pqfl.example.com
ALLOWED_ORIGINS=https://dashboard.pqfl.example.com,https://app.pqfl.example.com

# ---- Redis (opcional) ----
# Sem REDIS_URL: rate-limit usa store em memoria, denylist/cache desativados, jobs rodam inline.
# Com REDIS_URL: rate-limit distribuido, denylist de JWT, cache e filas BullMQ.
REDIS_URL=

# ---- Google OAuth (futuro — reservado, ainda nao implementado) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Swagger ----
SWAGGER_DEV_URL=http://localhost:8080
SWAGGER_PROD_URL=https://api.pqfl.example.com
